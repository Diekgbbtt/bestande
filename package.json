	"scripts": {
		"watch": "tsc -w",
		"eslint": "node --max_old_space_size=4096 ./node_modules/eslint/bin/eslint.js --cache '**/*.{js,ts,tsx}' --fix --ignore-path .gitignore",
		"test": "npm run eslint && ts-unused-exports tsconfig.json && npm run copy && tsc --incremental && TEST=true CI=true ava && ts-node scripts/detect-unused-strings.ts",
		"build": "npm run build-web",
		"build-ios": "npm run bundle-ios && gym --workspace ios/BestandeReact.xcworkspace --scheme BestandeReact",
		"start": "cd dist/web/src && node sync.js && node index.js",
		"start-app": "react-native start",
		"build-and-start": "npm run build && npm run start",
		"dev": "cd web && cross-env NODE_OPTIONS=--openssl-legacy-provider cross-env NODE_ENV=development ts-node-dev src/index.ts",
		"frontend": "cd web && NODE_ENV=development ts-node src/index.ts",
		"mongo": " docker run mongo -p 27017:27017",
		"postinstall": "patch-package && jetify",
		"build-web": "sh ./scripts/build-web.sh",
		"copy": "node copy.js",
		"bundle-android": "npx react-native bundle --entry-file=index.android.js --platform=android --dev=false --bundle-output=android/main.jsbundle.bundle --sourcemap-output android/main.jsbundle.map --assets-dest ./android",
		"bundle-ios": "npx react-native bundle --entry-file=index.js --platform=ios --dev=false --bundle-output=ios/main.jsbundle.bundle --sourcemap-output ios/main.jsbundle.map --assets-dest ./ios",
		"queue": "cd scripts && ts-node do-tasks.ts",
		"build-webapp": "rm -rf webapp && mkdir webapp && cp index.html webapp && NODE_ENV=production webpack -p",
		"webapp": "webpack-dev-server --host 0.0.0.0",
		"swagger-autogen": "node ./web/src/swagger.js"
	},
