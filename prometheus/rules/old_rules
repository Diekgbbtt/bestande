groups:
  - name: slo_alerts
    rules:
      # --- AVAILABILITY: FE CRITICAL ENDPOINTS ---
      - alert: FECriticalAvailabilityCritical
        expr: |
          (
            sum(rate(http_request_total{status_code=~"5..", route=~"/|/uzh/search|/voting|/login|/static/app.js|/static/main.css|/static/manifest.json"}[5m]))
            /
            sum(rate(http_request_total{route=~"/|/uzh/search|/voting|/login|/static/app.js|/static/main.css|/static/manifest.json"}[5m])) > 0.072
          )
          AND
          (
            sum(rate(http_request_total{status_code=~"5..", route=~"/|/uzh/search|/voting|/login|/static/app.js|/static/main.css|/static/manifest.json"}[1h]))
            /
            sum(rate(http_request_total{route=~"/|/uzh/search|/voting|/login|/static/app.js|/static/main.css|/static/manifest.json"}[1h])) > 0.072
          )
        labels:
          severity: critical

      - alert: FECriticalAvailabilityWarning
        expr: |
          (sum(rate(http_request_total{status_code=~"5..", route=~"/|/uzh/search|/voting|/login|/static/app.js|/static/main.css|/static/manifest.json"}[2h])) / sum(rate(http_request_total{route=~"/|/uzh/search|/voting|/login|/static/app.js|/static/main.css|/static/manifest.json"}[2h])) > 0.015)
          AND
          (sum(rate(http_request_total{status_code=~"5..", route=~"/|/uzh/search|/voting|/login|/static/app.js|/static/main.css|/static/manifest.json"}[1d])) / sum(rate(http_request_total{route=~"/|/uzh/search|/voting|/login|/static/app.js|/static/main.css|/static/manifest.json"}[1d])) > 0.015)
        labels:
          severity: warning

      # --- HTTP LATENCY: FRONTEND STANDARD LOAD ---
      - alert: FrontendLatencyCritical
        expr: |
          (
            sum(rate(http_requests_latency_count{route=~"/|/uzh/search|/voting|/login|/static/.*"}[5m]))
            - sum(rate(http_requests_latency_bucket{le="0.5",route=~"/|/uzh/search|/voting|/login|/static/.*"}[5m]))
          ) / sum(rate(http_requests_latency_count{route=~"/|/uzh/search|/voting|/login|/static/.*"}[5m])) > 0.5
          AND
          (
            sum(rate(http_requests_latency_count{route=~"/|/uzh/search|/voting|/login|/static/.*"}[1h]))
            - sum(rate(http_requests_latency_bucket{le="0.5",route=~"/|/uzh/search|/voting|/login|/static/.*"}[1h]))
          ) / sum(rate(http_requests_latency_count{route=~"/|/uzh/search|/voting|/login|/static/.*"}[1h])) > 0.5
        labels:
          severity: critical

      - alert: FrontendLatencyWarning
        expr: |
          (
            sum(rate(http_requests_latency_count{route=~"/|/uzh/search|/voting|/login|/static/.*"}[2h]))
            - sum(rate(http_requests_latency_bucket{le="0.5",route=~"/|/uzh/search|/voting|/login|/static/.*"}[2h]))
          ) / sum(rate(http_requests_latency_count{route=~"/|/uzh/search|/voting|/login|/static/.*"}[2h])) > 0.1
          AND
          (
            sum(rate(http_requests_latency_count{route=~"/|/uzh/search|/voting|/login|/static/.*"}[1d]))
            - sum(rate(http_requests_latency_bucket{le="0.5",route=~"/|/uzh/search|/voting|/login|/static/.*"}[1d]))
          ) / sum(rate(http_requests_latency_count{route=~"/|/uzh/search|/voting|/login|/static/.*"}[1d])) > 0.1
        labels:
          severity: warning

      # --- HTTP ERRORS: ALL FE ENDPOINTS ---
      - alert: FrontendErrorsCritical
        expr: |
          (sum(rate(http_requests_latency_count{status_code=~"5..",route=~"/|/uzh/search|/voting|/login|/static/.*"}[5m])) / sum(rate(http_requests_latency_count{route=~"/|/uzh/search|/voting|/login|/static/.*"}[5m])) > 0.1)
          AND
          (sum(rate(http_requests_latency_count{status_code=~"5..",route=~"/|/uzh/search|/voting|/login|/static/.*"}[1h])) / sum(rate(http_requests_latency_count{route=~"/|/uzh/search|/voting|/login|/static/.*"}[1h])) > 0.1)
        labels:
          severity: critical

      - alert: FrontendErrorsWarning
        expr: |
          (sum(rate(http_requests_latency_count{status_code=~"5..",route=~"/|/uzh/search|/voting|/login|/static/.*"}[6h])) / sum(rate(http_requests_latency_count{route=~"/|/uzh/search|/voting|/login|/static/.*"}[6h])) > 0.02)
          AND
          (sum(rate(http_requests_latency_count{status_code=~"5..",route=~"/|/uzh/search|/voting|/login|/static/.*"}[3d])) / sum(rate(http_requests_latency_count{route=~"/|/uzh/search|/voting|/login|/static/.*"}[3d])) > 0.02)
        labels:
          severity: warning

      # --- BACKEND API LATENCY ---
      - alert: BackendLatencyCritical
        expr: |
          (
            sum(rate(http_requests_latency_count{route=~"/api/institution/uzh/module/.*"}[2m]))
            - sum(rate(http_requests_latency_bucket{le="0.3",route=~"/api/institution/uzh/module/.*"}[2m]))
          ) / sum(rate(http_requests_latency_count{route=~"/api/institution/uzh/module/.*"}[2m])) >= 1.0
          AND
          (
            sum(rate(http_requests_latency_count{route=~"/api/institution/uzh/module/.*"}[30m]))
            - sum(rate(http_requests_latency_bucket{le="0.3",route=~"/api/institution/uzh/module/.*"}[30m]))
          ) / sum(rate(http_requests_latency_count{route=~"/api/institution/uzh/module/.*"}[30m])) >= 1.0
        labels:
          severity: critical

      - alert: BackendLatencyWarning
        expr: |
          (
            sum(rate(http_requests_latency_count{route=~"/api/institution/uzh/module/.*"}[1h]))
            - sum(rate(http_requests_latency_bucket{le="0.3",route=~"/api/institution/uzh/module/.*"}[1h]))
          ) / sum(rate(http_requests_latency_count{route=~"/api/institution/uzh/module/.*"}[1h])) > 0.2
          AND
          (
            sum(rate(http_requests_latency_count{route=~"/api/institution/uzh/module/.*"}[12h]))
            - sum(rate(http_requests_latency_bucket{le="0.3",route=~"/api/institution/uzh/module/.*"}[12h]))
          ) / sum(rate(http_requests_latency_count{route=~"/api/institution/uzh/module/.*"}[12h])) > 0.2
        labels:
          severity: warning

      # --- These last 3 rules about error rate handle the edge cases that the other do not fully encapsulate. ---
      - alert: HighErrorRateShortTerm
        expr: |
          sum(rate(http_request_total{status_code=~"5..", route=~"/|/uzh/search|/voting|/login|/static/.*"}[1m]))
          /
          sum(rate(http_request_total{route=~"/|/uzh/search|/voting|/login|/static/.*"}[1m])) > 0.2
        labels:
          severity: critical
        annotations:
          summary: "Massive error spike detected"
          description: "Over 20% of requests in the last 1 minute are failing."

      # 2. Budget Consumption: < 50% remaining mid-period (15 days)
      # This checks if the error rate over 15 days has already consumed half of the 1% monthly budget
      - alert: ErrorBudgetHalfConsumedMidMonth
        expr: |
          sum(rate(http_request_total{status_code=~"5..", route=~"/|/uzh/search|/voting|/login|/static/.*"}[15d]))
          /
          sum(rate(http_request_total{route=~"/|/uzh/search|/voting|/login|/static/.*"}[15d])) > 0.005
        labels:
          severity: warning
        annotations:
          summary: "Error budget depleting too fast"
          description: "50% of the monthly error budget has been consumed in only 15 days."

      # 3. Sustained Burn: 6h Error Ratio > Error Budget (0.01)
      - alert: SustainedErrorBudgetBurn
        expr: |
          sum(rate(http_request_total{status_code=~"5..", route=~"/|/uzh/search|/voting|/login|/static/.*"}[6h]))
          /
          sum(rate(http_request_total{route=~"/|/uzh/search|/voting|/login|/static/.*"}[6h])) > 0.01
        labels:
          severity: warning
        annotations:
          summary: "6h Error rate exceeds total budget"
          description: "The error rate over the last 6 hours is higher than the allowed 1% threshold."

  - name: ssl_alerts
    rules:
      - alert: SSLCertExpiringSoon
        expr: (probe_ssl_earliest_cert_expiry - time()) / 86400 < 30
        for: 10m
        labels:
          severity: warning
          slo: ssl_certificate
        annotations:
          summary: "SSL certificate expiring soon"
          description: "SSL certificate for {{ $labels.instance }} will expire in less than 30 days."

      - alert: SSLCertExpiringCritical
        expr: (probe_ssl_earliest_cert_expiry - time()) / 86400 < 15
        for: 10m
        labels:
          severity: critical
          slo: ssl_certificate
        annotations:
          summary: "SSL certificate expiring very soon"
          description: "SSL certificate for {{ $labels.instance }} will expire in less than 15 days."
