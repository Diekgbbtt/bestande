{
	"$schema": "http://json.schemastore.org/prettierrc",
	"printWidth": 85,
	"tabWidth": 4,
	"semi": true,
	"singleQuote": true,
	"quoteProps": "as-needed",
	"trailingComma": "es5",
	"bracketSpacing": false,
	"arrowParens": "always",
	"htmlWhitespaceSensitivity": "strict",
	"endOfLine": "crlf",
	"useTabs": true
}
